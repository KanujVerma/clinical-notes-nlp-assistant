{
  "framework": null,
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feat/clinical-validation-workbench": false,
      "main": false,
      "feat/hosted-synthetic-release": false,
      "feat/local-vision-evaluation": false,
      "feat/recorded-evidence-showcase": false,
      "feat/real-vision-benchmark": false,
      "feat/medication-gold-replay-and-parser": false,
      "feat/prospective-synthetic-holdout": false,
      "feat/paired-local-model-comparison": false,
      "feat/genuine-handwriting-validation": false
    }
  }
}
